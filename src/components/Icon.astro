---
// Lucide-Icons als Inline-SVG, Strichstärke an das Design angepasst.
const icons = import.meta.glob('/node_modules/lucide-static/icons/{clock,map,gamepad-2,eye-off,book-open,users,search,youtube,check,arrow-right,star,hard-drive,download,shield-check,sparkles,map-pin,film,list-checks,radio,menu,x,arrow-up-right,info,triangle-alert}.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; size?: number; class?: string }
const { name, size = 22, class: cls = '' } = Astro.props;
const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`] ?? '';
const svg = raw
  .replace(/width="\d+"/, `width="${size}"`)
  .replace(/height="\d+"/, `height="${size}"`)
  .replace(/stroke-width="[\d.]+"/, 'stroke-width="1.75"')
  .replace('<svg', `<svg aria-hidden="true" class="icon ${cls}"`);
---
<Fragment set:html={svg} />
